{
  "manifest_version": 3,
  "name": "Thumbnail View — Aperçu de miniature YouTube",
  "version": "2.4.1",
  "description": "Visualise ta miniature et ton titre directement dans le feed YouTube, au milieu des vraies vidéos.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thumbnail View",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["common.js", "content.js", "transcript.js", "videos.js"],
      "css": ["content.css", "transcript.css", "videos.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
