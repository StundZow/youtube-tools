{
  "manifest_version": 3,
  "name": "YouTube Tools",
  "version": "3.8.0",
  "description": "Boîte à outils YouTube : aperçu de miniature dans le vrai feed, transcription, résumés de la vidéo et des commentaires par Gemini, export CSV des vidéos et classement sur 10.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "common.js",
        "content.js",
        "transcript.js",
        "summary.js",
        "comments.js",
        "videos.js",
        "rank-core.js",
        "rank.js"
      ],
      "css": [
        "content.css",
        "transcript.css",
        "summary.css",
        "videos.css",
        "rank.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "rank-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
